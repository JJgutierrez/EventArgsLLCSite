{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/multi-agent",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/multi-agent-orchestrator",
      "destination": "/engineering-insights",
      "permanent": true
    },
    {
      "source": "/case-studies/multi-agent-orchestrator",
      "destination": "/case-studies",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/qualify",
      "destination": "https://eventargs-qualification-bot.vercel.app/qualify"
    },
    {
      "source": "/qualify/:match*",
      "destination": "https://eventargs-qualification-bot.vercel.app/qualify/:match*"
    }
  ]
}
